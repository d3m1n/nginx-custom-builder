#!/bin/sh

set -e

# ---------------------------------------------------------------------------
# LOCAL DEVIATION from nginx/pkg-oss @ fffcac06 (see NOTICE.md):
# Never start or binary-upgrade nginx if the configuration does not validate.
# Upstream unconditionally runs the init-script upgrade/start path here.
# We guard it with `nginx -t` so a broken user configuration can never lead
# to a failed or unsafe restart. On failure the service is left untouched
# and the operator gets explicit instructions.
# ---------------------------------------------------------------------------
nginx_config_ok() {
    if [ -x "/usr/sbin/nginx" ] && /usr/sbin/nginx -t >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

if [ "$1" != "configure" ]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# LOCAL DEVIATION (see NOTICE.md): keep the pre-existing configuration by
# default. When migrating from Ubuntu nginx (nginx-common/nginx-core) the
# Debian-style nginx.conf would otherwise be silently replaced by the
# nginx.org-style default. preinst backed up the old config to
# /etc/nginx/nginx.conf.pre-ncb; restore it if dpkg replaced it. The package
# default remains available at /usr/share/nginx/nginx.conf.default.
# ---------------------------------------------------------------------------
if [ -f /etc/nginx/nginx.conf.pre-ncb ]; then
    if ! cmp -s /etc/nginx/nginx.conf /etc/nginx/nginx.conf.pre-ncb; then
        cp -a /etc/nginx/nginx.conf /etc/nginx/nginx.conf.package-default
        cp -a /etc/nginx/nginx.conf.pre-ncb /etc/nginx/nginx.conf
        echo "NOTICE: existing /etc/nginx/nginx.conf preserved by default." >&2
        echo "  The package default was saved to /etc/nginx/nginx.conf.package-default" >&2
        echo "  and is also available at /usr/share/nginx/nginx.conf.default." >&2
        echo "  To adopt the new default: cp /usr/share/nginx/nginx.conf.default /etc/nginx/nginx.conf && nginx -t" >&2
    fi
fi

# Touch and set permisions on default log files on installation
if [ -z "$2" ]; then
    if [ -d /var/log/nginx ]; then
        if [ ! -e /var/log/nginx/access.log ]; then
            touch /var/log/nginx/access.log
            chmod 640 /var/log/nginx/access.log
            chown nginx:adm /var/log/nginx/access.log
        fi

        if [ ! -e /var/log/nginx/error.log ]; then
            touch /var/log/nginx/error.log
            chmod 640 /var/log/nginx/error.log
            chown nginx:adm /var/log/nginx/error.log
        fi
    fi
fi

if [ -x "/etc/init.d/nginx" ]; then
    if ! nginx_config_ok; then
        echo "nginx configuration test (nginx -t) FAILED; nginx was NOT started or reloaded." >&2
        echo "Fix the configuration (see /var/log/nginx/error.log output from nginx -t)," >&2
        echo "then run: systemctl start nginx   (or: nginx, then: nginx -s reload)" >&2
    elif [ -f "/run/nginx.pid" ] && kill -0 `cat /run/nginx.pid` >/dev/null; then
        /etc/init.d/nginx upgrade || echo \
            "Binary upgrade failed, please check nginx's error.log"
    else
        if [ -x "`which invoke-rc.d 2>/dev/null`" ]; then
            invoke-rc.d nginx start || true
        else
            /etc/init.d/nginx start || true
        fi
    fi
fi

#DEBHELPER#

exit 0
