# Build container for Ubuntu 22.04 jammy (amd64) — nginx-custom-builder
# Base image pinned by digest (determinism; see docs/ARCHITECTURE.md D6).
FROM ubuntu@sha256:9abcaffc92a5279fff3a6a41635c0800ea33e528425fb389658806476e7defde

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        debhelper \
        devscripts \
        equivs \
        git \
        gnupg \
        libbrotli-dev \
        libpcre2-dev \
        libssl-dev \
        libxml2-utils \
        lsb-release \
        quilt \
        xsltproc \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
